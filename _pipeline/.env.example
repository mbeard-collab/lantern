# CrateDB connection
# The HTTP endpoint for your CrateDB cluster, e.g. https://cratedb.example.com
CRATE_URL=

# Read-only CrateDB credentials
CRATE_USER=
CRATE_PASSWORD=

# Anthropic key for narrative generation (separate from STUDIO_ANTHROPIC_KEY)
PIPELINE_ANTHROPIC_KEY=

# Pipeline auth token — must match PIPELINE_SECRET in the Netlify env vars
# Used by the data action in /api/commit (does not share the human admin password)
PIPELINE_SECRET=

# The live site base URL (no trailing slash)
SITE_URL=https://govspend-ops-dashboards.netlify.app
